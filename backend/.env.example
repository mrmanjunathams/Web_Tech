# Copy this file to .env and fill in the values.

# HTTP port the server (frontend + API) listens on
PORT=3000

# MongoDB connection string (local install, Docker, or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/bloggerbytes

# Long random string used to sign session cookies (required in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Set to "production" when deploying (enables secure cookies)
NODE_ENV=development

# Optional: SMTP settings for the welcome email sent on sign-up.
# Leave SMTP_USER empty to disable email. For Gmail use an App Password.
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional: where the built Angular app lives (served by this server when present).
# Defaults to ../frontend/dist/frontend/browser
# FRONTEND_DIST=
# Optional: folder of Image Pool pictures used to validate blog images.
# Defaults to ../frontend/public/picyourpic
# IMAGE_DIR=
# Optional: comma-separated frontend origins allowed to call this API from another domain,
# e.g. https://bloggerbytes.example.com (not needed when served together or via the dev proxy)
# CORS_ORIGIN=
