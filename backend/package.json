{
  "name": "bloggerbytes-backend",
  "version": "2.0.0",
  "description": "Bloggerbytes REST API (Express + MongoDB)",
  "main": "src/index.js",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "dev:memory": "node --env-file-if-exists=.env src/dev-memory.js",
    "test": "node --test --test-concurrency=1 test/"
  },
  "author": "Manjunatha M S",
  "license": "ISC",
  "dependencies": {
    "connect-mongo": "^6.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1"
  }
}
